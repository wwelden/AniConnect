{
  "name": "aniconnect",
  "version": "0.3.0",
  "description": "AniList MCP server: manage your anime list from Claude or any MCP client",
  "keywords": ["anilist", "mcp", "mcp-server", "model-context-protocol", "anime", "anime-list", "claude"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wwelden/AniConnect.git"
  },
  "homepage": "https://github.com/wwelden/AniConnect#readme",
  "bugs": "https://github.com/wwelden/AniConnect/issues",
  "mcpName": "io.github.wwelden/aniconnect",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "aniconnect": "dist/index.js"
  },
  "files": ["dist"],
  "scripts": {
    "start": "bun src/index.ts",
    "build": "bun scripts/build.ts",
    "prepack": "bun run build",
    "smoke:package": "bun scripts/package-smoke.ts",
    "serve": "bun src/http.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p .",
    "eval": "bun evals/run.ts",
    "snapshot": "bun scripts/snapshot-fixtures.ts",
    "snapshot:schema": "bun scripts/snapshot-schema.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "graphql": "16",
    "typescript": "^7.0.2"
  }
}
